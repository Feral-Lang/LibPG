# Importable file for the package LibPQ generated by Feral package manager

loadlib('pg/PG');

let getVersion = fn() {
    let v = getVersionNative();
    let s = '';
    s += (v / 10000).str();
    s += '.';
    s += (v % 10000).str();
    # pq doesn't have patch versions since major version 10
    return s;
};

let getVersion in PGConnTy = fn() {
    let v = self.getVersionNative();
    let s = '';
    s += (v / 10000).str();
    s += '.';
    s += (v % 10000).str();
    return s;
};