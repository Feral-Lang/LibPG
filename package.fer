let vec = import('std/vec');
let package = import('std/package');

let configure = fn(info) {
    let pkg = package.new(
        'PG',
        desc = 'Postgresql interface for Feral, using libpq.',
        version = '0.0.2',
        feral = '>=2.6.0',
        author = vec.new('Chirag-Khandelwal <github@mail.chiragkh.me>')
    );

    pkg.requires('libpq', version = '~18.4');

    let pgTarget = pkg.addTarget('PG');
    pgTarget.findHeaders(info.pkgRoot / 'lib', '(.*).hpp');
    pgTarget.findSources(info.pkgRoot / 'lib', '(.*).cpp');

    return feral.ok(pkg);
};
